{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/fonts/*",
      "/tesseract/*",
      "*.wasm",
      "*.mjs",
      "*.js",
      "*.css",
      "*.png",
      "*.ico",
      "*.webmanifest",
      "/robots.txt",
      "/sw.js",
      "/manifest.webmanifest"
    ]
  },
  "mimeTypes": {
    ".wasm": "application/wasm",
    ".webmanifest": "application/manifest+json"
  }
}
